# Example dynamic configuration file
# Copy this file and rename to dynamic.yml to use it

http:
  serversTransports:
    skipverify:
      insecureSkipVerify: true
  routers:
    app-rtr:
      rule: Host(`app.example.com`)
      service: app-svc
      middlewares:
        - rate-limit@file
      entryPoints:
        - https
      tls: {}
  services:
    app-svc:
      loadBalancer:
        serversTransport: skipverify
        servers:
          - url: "http://xxx.xxx.xxx.xxx"

tcp:
  routers:
    app-svc-tcp-rtr:
      rule: HostSNI(`app.example.com`)
      entryPoints:
        - https
      service: app-svc-tcp
      middlewares:
        - tcp-local@file
      tls:
        # TLS passthrough - Traefik does not terminate TLS
        passthrough: true
  services:
    app-svc-tcp:
      loadBalancer:
        servers:
          - address: "xxx.xxx.xxx.xxx:xxxx"
